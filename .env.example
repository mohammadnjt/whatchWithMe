# BAS sets PORT itself; this is only used when running the server by hand.
PORT=3000
# Optional: interface to listen on (default 0.0.0.0). Use 127.0.0.1 behind nginx.
HOST=0.0.0.0
# BAS does not pass its own ADMIN_* variables to apps, so set them here (in this app's .env).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Delete uploaded videos after this many hours (0 = keep forever).
FILE_RETENTION_HOURS=24
# Let the link tools (proxy / check-url / remote download) reach LAN or loopback addresses,
# e.g. a NAS on the local network. Off by default to protect the server's internal network.
PROXY_ALLOW_PRIVATE=false

# --- Voice chat (WebRTC) ---
# Audio goes peer-to-peer. Direct connections fail behind symmetric NAT and
# carrier-grade NAT, so the app also runs its own TURN relay for the fallback.
# Set to false to rely on STUN alone (lighter, but voice breaks on some networks).
TURN_ENABLED=true
# Public address browsers should reach the relay on. Auto-detected when empty.
TURN_PUBLIC_IP=
# Listening port for STUN/TURN, on both udp and tcp. Must be open in the firewall.
TURN_PORT=3479
# Shared secret used to sign the short-lived TURN logins handed to browsers.
# Generated into data/turn.secret on first run when left empty; keep it stable,
# since changing it invalidates the credentials of everyone connected.
TURN_SECRET=
# Port range the relay forwards media through. Must be open in the firewall.
TURN_RELAY_MIN=49500
TURN_RELAY_MAX=49700
# STUN servers offered alongside the relay, comma separated.
STUN_SERVERS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Optional extra ICE servers (an external TURN service), as a JSON array:
# EXTRA_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
EXTRA_ICE_SERVERS=

# --- Subtitles ---
# Subtitle files are converted to WebVTT and stored under data/subtitles.
# Pulling a subtitle track out of a video file additionally needs ffmpeg and
# ffprobe on PATH; without them, subtitles can still be uploaded or linked.
